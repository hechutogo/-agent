# 云端配置模板；真实凭据只放在 .env 或环境变量，不要提交。
# 环境变量优先于 .env。所有模型均为远端 API，不下载本地模型。
# 下面是 OpenAI 兼容接口示例，请按供应商实际支持的模型填写。
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# VLM 只接收 RGB 并返回像素 bbox；深度反投影在本地执行。
# 默认在云端 bbox 内按红/蓝/绿色筛选深度，XY 使用可见范围分位数中点。
# 这是公开标注的本地 RGB 颜色细化，不是纯云端定位，也不使用分割 ID。
# 空的 BASE_URL 回退到 LLM；API_KEY 只在同源端点间回退，MODEL 不回退。
VLM_API_KEY=
VLM_BASE_URL=
VLM_MODEL=qwen-vl-max

# 仅 --audio / --record 需要 ASR；端点须支持 /audio/transcriptions。
# 不同供应商的多模态对话 ASR 不等同于这个 OpenAI 转写接口。
ASR_API_KEY=
ASR_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1

# 无凭据时可用 --smoke，或 --demo A B（明确的 OpenCV 基线，不是云端验证）。
# --record 还需要安装可选依赖：pip install '.[microphone]'

# 持久化日志与 Trace：按日 JSONL 写入该目录，默认仓库根 logs/。
# 超期日志按天清理；级别可取 debug/info/warning/error。
PICKPARTS_LOG_DIR=
PICKPARTS_LOG_RETENTION_DAYS=7
PICKPARTS_LOG_LEVEL=info
